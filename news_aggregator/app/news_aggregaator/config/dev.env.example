# Example Environment Variables
# Copy this file to .env.development, .env.production, etc. and fill in your values

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_CONNECTION_STRING=mongodb://localhost:27017/your_database_name

# JWT Configuration (IMPORTANT: Change these in production!)
ACCESS_TOKEN_SECRET=change_this_to_a_very_long_random_string_at_least_32_characters
JWT_EXPIRES_IN=7d

# Session Configuration (IMPORTANT: Change this in production!)
SESSION_SECRET=change_this_to_another_very_long_random_string_at_least_32_characters

# Email Configuration
EMAIL_HOST=smtp.your-email-provider.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_password_or_app_specific_password
EMAIL_FROM=noreply@yourdomain.com

# News API Configuration
# Get your API key from: https://gnews.io/
GNEWS_API_KEY=your_gnews_api_key_here
ENABLE_NEWS_SCHEDULER=false

# File Upload Configuration
MAX_FILE_SIZE=5242880  # 5MB in bytes
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100  # Max requests per window

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Production-specific settings (uncomment and configure for production)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname
# SSL_ENABLED=true
# TRUST_PROXY=true