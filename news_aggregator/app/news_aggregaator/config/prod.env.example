# Production Environment Variables Example
# Copy this to prod.env and fill with your production values

# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (MongoDB Atlas or Production DB)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/prod_database

# JWT Configuration (CRITICAL: Use strong, unique secrets in production!)
ACCESS_TOKEN_SECRET=generate_a_very_strong_random_string_at_least_64_characters_for_production
JWT_EXPIRES_IN=7d

# Session Configuration (CRITICAL: Use strong, unique secrets in production!)
SESSION_SECRET=generate_another_very_strong_random_string_at_least_64_characters_for_production

# Email Configuration (Brevo SMTP)
HOST=smtp-relay.brevo.com
BREVO_PORT=587
USER=your_production_brevo_username@smtp-brevo.com
PASS=your_production_brevo_smtp_key
EMAIL_FROM=noreply@yourdomain.com

# News API Configuration
GNEWS_API_KEY=your_production_gnews_api_key
ENABLE_NEWS_SCHEDULER=true

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif

# Rate Limiting (Stricter for production)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50

# CORS Configuration
CORS_ORIGIN=https://yourdomain.com

# Production-specific
SSL_ENABLED=true
TRUST_PROXY=true